<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_catalog_customer_list" model="ir.ui.view">
    <field name="name">catalog.customer.list</field>
    <field name="model">catalog.customer</field>
    <field name="arch" type="xml">
      <list string="Clientes">
        <field name="partner_id"/>
        <field name="user_id"/>
        <field name="status"/>
        <field name="phone"/>
        <field name="email"/>
      </list>
    </field>
  </record>

  <record id="view_catalog_customer_form" model="ir.ui.view">
    <field name="name">catalog.customer.form</field>
    <field name="model">catalog.customer</field>
    <field name="arch" type="xml">
      <form string="Cliente">
        <sheet>
          <group>
            <field name="partner_id"/>
            <field name="user_id"/>
            <field name="status"/>
          </group>
          <group>
            <field name="phone"/>
            <field name="email"/>
          </group>
          <group>
            <field name="notes"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_catalogix_customers" model="ir.actions.act_window">
    <field name="name">Clientes</field>
    <field name="res_model">catalog.customer</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_catalogix_customers"
            name="Clientes"
            parent="menu_catalogix_root"
            action="action_catalogix_customers"
            sequence="35"/>
</odoo>
