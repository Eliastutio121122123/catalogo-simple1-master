<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catalog_audit_log_list" model="ir.ui.view">
        <field name="name">catalog.audit.log.list</field>
        <field name="model">catalog.audit.log</field>
        <field name="arch" type="xml">
            <list string="Auditoria">
                <field name="code"/>
                <field name="occurred_at"/>
                <field name="actor_name"/>
                <field name="actor_role"/>
                <field name="ip_address"/>
                <field name="action"/>
                <field name="target"/>
                <field name="severity"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_catalog_audit_log_form" model="ir.ui.view">
        <field name="name">catalog.audit.log.form</field>
        <field name="model">catalog.audit.log</field>
        <field name="arch" type="xml">
            <form string="Auditoria">
                <sheet>
                    <group>
                        <field name="code" readonly="1"/>
                        <field name="occurred_at"/>
                        <field name="actor_name"/>
                        <field name="actor_role"/>
                        <field name="ip_address"/>
                    </group>
                    <group>
                        <field name="action"/>
                        <field name="target"/>
                        <field name="severity"/>
                        <field name="status"/>
                    </group>
                    <field name="meta_json"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_catalogix_audit_log" model="ir.actions.act_window">
        <field name="name">Auditoria</field>
        <field name="res_model">catalog.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_catalogix_audit_log"
              name="Auditoria"
              parent="menu_catalogix_root"
              action="action_catalogix_audit_log"
              sequence="70"/>
</odoo>
