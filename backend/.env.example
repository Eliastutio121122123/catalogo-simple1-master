# Flask
FLASK_DEBUG=true
SECRET_KEY=your-secret-key-here

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRY_HOURS=24
JWT_REFRESH_DAYS=30

# Password reset
# How long the reset token is valid (minutes)
RESET_TOKEN_MINUTES=30
# URL where the user will land to reset the password
FRONTEND_URL=http://localhost:5173
# If true, the backend will send the email (otherwise, in DEBUG it returns reset_url in the response)
SEND_RESET_EMAIL=false
# For Gmail SMTP, it is best if this matches SMTP_USER (or is a configured alias)
RESET_EMAIL_FROM=no-reply@catalogix.local
# smtp | odoo
RESET_EMAIL_PROVIDER=smtp

# Google Sign-In (free; uses Google Identity Services)
# Create an OAuth Client ID (Web application) and set the Client ID here.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=

# SMTP (to send password reset emails)
# Dev suggestion: MailHog (SMTP localhost:1025) or similar.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true (use an App Password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# Odoo
ODOO_URL=http://localhost:8069
ODOO_DB=catalogix
ODOO_USER=admin
ODOO_PASSWORD=admin

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# You can use {ORDER} and {CHECKOUT_SESSION_ID} in the success URL
STRIPE_SUCCESS_URL=http://localhost:5173/payment-result?status=success&order={ORDER}&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/checkout?status=cancel

# WhatsApp (Meta Cloud API)
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=v19.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Recommended for webhook signature verification
WHATSAPP_APP_SECRET=
# Example: "1" for NANP countries (without +). If empty, numbers must already be in international format.
WHATSAPP_DEFAULT_COUNTRY_CODE=

# Optional notifications
WHATSAPP_NOTIFY_PAYMENTS=false
# If defined, it will be sent as a template (requires 2 body params: {invoice_name}, {amount}).
WHATSAPP_PAYMENT_TEMPLATE=
WHATSAPP_PAYMENT_LANGUAGE=es
